require open Stdlib.Z;
require open Stdlib.Bool;
require open Stdlib.List;

// Following Barthe–Geuvers (CSL'95, "Congruence types"), we set up bitvectors
// of width n as the congruence type generated by the rewrite system
//
//     mkbv n x ⟶ρ MVBV n (x mod 2^n)
//
// Here MVBV is the *fundamental constructor* (§4.1): every closed term of
// type BV n reduces to one whose head is MVBV applied to a canonical value
// in [0, 2^n). All bitvector operations are defined by pattern-matching on
// MVBV and rebuilding via mkbv, which immediately re-fires the ρ-rule so
// that outputs are always in canonical form. Rules are non-duplicating
// (Theorem 3 of the paper applies for the operation rules; only the ρ-rule
// itself duplicates the width index n).

injective symbol BV: τ nat → TYPE;

// Set-code companion. Needed so that equality `=` and `if` (which both
// require their carrier to live in τ) can be applied to bitvectors.
// Pattern borrowed from `Fin / fin` in [Fin.lp].
symbol bv : τ nat → Set;
rule τ (bv $n) ↪ BV $n;

// Canonical (fundamental) constructor: invariant after the ρ-rule, value
// lies in [0, 2^n).
symbol MVBV (n :τ nat) : τ int → BV n;

// Public constructor: accepts any integer; ρ-normalised by the rule below.
symbol mkbv (n :τ nat) : τ int → BV n;

rule (mkbv $n $x) ↪ MVBV $n (modulo $x (2 ^ (to_int $n)));

type 5;

compute (mkbv (to_nat 5) 50); // should compute to MVBV 4 2, since 10 mod 16 is 2

// ----------------------------------------------------------------------
// Bitvector operations
// ----------------------------------------------------------------------

// Two's-complement negation: −x mod 2^n.
symbol bvneg [n : τ nat] : BV n → BV n;
rule @bvneg $n (MVBV _ $x) ↪ mkbv $n (— $x);

// Bitwise NOT on n bits.  Defined directly in terms of the bit-list
// helpers `bits_of` and `bbT` (declared below): unfold the bitvector
// into its n MSB-first bits, flip each bit, then re-pack. The rewrite
// rule for `bvnot` is given later in the file (after `bits_of` and
// `bbT` are defined) and is unconditional — it fires on any BV n
// argument, not just MVBV-headed ones. This makes `bitblast_not` hold
// definitionally (proof = `reflexivity`).
//
// For canonical inputs v ∈ [0, 2ⁿ) the result matches the arithmetic
// formula (2ⁿ − 1) − v exactly; the previous arithmetic rule has been
// replaced because it disagreed with the bit-list semantics on
// non-canonical MVBV terms (e.g. MVBV 2 (−1)) and so made the bitblast
// equation false as stated.
symbol bvnot [n : τ nat] : BV n → BV n;

// Modular addition.
symbol bvadd [n : τ nat] : BV n → BV n → BV n;
rule @bvadd $n (MVBV _ $x) (MVBV _ $y) ↪ mkbv $n ($x + $y);

// Modular multiplication.
symbol bvmul [n : τ nat] : BV n → BV n → BV n;
rule @bvmul $n (MVBV _ $x) (MVBV _ $y) ↪ mkbv $n ($x * $y);

// Bitwise AND / OR — lifted from Nat-level bit-operations. After the ρ-rule
// the canonical value of an MVBV lies in [0, 2^n), so to_nat is a faithful
// embedding and the Nat result is again < 2^n, so the final mkbv is just a
// (definitional) reassertion of normal form.

// `bvand` — SMT-LIB-aligned definition: bitwise AND lifted from Nat's
// bitwise `&&`. For canonical inputs this matches the spec
// `[[bvand s t]] = nat2bv[m](bv2nat(s) && bv2nat(t))` (with the bit-by-bit
// reading of `bvand` on m-bit values).
symbol bvand [n : τ nat] : BV n → BV n → BV n;
rule @bvand $n (MVBV _ $x) (MVBV _ $y) ↪
  mkbv $n (to_int ((to_nat $x) && (to_nat $y)));

// `bvor` — SMT-LIB-aligned, via Nat's bitwise `⎪⎪`.
symbol bvor [n : τ nat] : BV n → BV n → BV n;
rule @bvor $n (MVBV _ $x) (MVBV _ $y) ↪
  mkbv $n (to_int ((to_nat $x) ⎪⎪ (to_nat $y)));

// Unsigned division and remainder.
// SMT-LIB convention: bvudiv x 0 = all-ones, bvurem x 0 = x.
// We pattern-match on the divisor rather than use `if`, because BV n lives
// in TYPE while `if` is only τ/Set-polymorphic. After ρ-normalisation the
// divisor is Z0 or Zpos _ — never Zneg — so two rules suffice.

symbol bvudiv [n : τ nat] : BV n → BV n → BV n;
rule @bvudiv $n (MVBV _ _)  (MVBV _  Z0)        ↪ mkbv $n ((2 ^ (to_int $n)) - 1)
with @bvudiv $n (MVBV _ $x) (MVBV _ (Zpos $p))  ↪ mkbv $n (div $x (Zpos $p));

symbol bvurem [n : τ nat] : BV n → BV n → BV n;
rule @bvurem $n (MVBV _ $x) (MVBV _  Z0)        ↪ mkbv $n $x
with @bvurem $n (MVBV _ $x) (MVBV _ (Zpos $p))  ↪ mkbv $n (modulo $x (Zpos $p));

// Logical shifts. In SMT-LIB the shift amount is itself a bitvector of the
// same width, interpreted as an unsigned integer. After ρ-normalisation
// $y ∈ [0, 2^n), hence 2^y is a positive integer and div is well-defined.

symbol bvshl [n : τ nat] : BV n → BV n → BV n;
rule @bvshl $n (MVBV _ $x) (MVBV _ $y) ↪ mkbv $n ($x * (2 ^ $y));

symbol bvlshr [n : τ nat] : BV n → BV n → BV n;
rule @bvlshr $n (MVBV _ $x) (MVBV _ $y) ↪ mkbv $n (div $x (2 ^ $y));

// ----------------------------------------------------------------------
// Alethe bit-blasting helpers (§4.1 of the Alethe spec)
// ----------------------------------------------------------------------
// Convention from the spec: a bitvector ⟨u₀, …, u_{n−1}⟩ has u₀ as the
// most significant bit and u_{n−1} as the least significant bit.

// bvsize : returns the width index n of a bitvector.
symbol bvsize [n : τ nat] : BV n → τ nat;
rule @bvsize $n _ ↪ $n;

// bbterm : pack a boolean list (head = MSB) into a bitvector.
// We compute the integer value by left-folding with an accumulator:
//   acc' = 2·acc + b, treating each successive list element as a
// lower-order bit. The final BV has width = size l.

symbol bbterm_acc : 𝕃 bool → τ int → τ int;
rule bbterm_acc □               $acc ↪ $acc
with bbterm_acc (true  ⸬ $bs)  $acc ↪ bbterm_acc $bs (2 * $acc + 1)
with bbterm_acc (false ⸬ $bs)  $acc ↪ bbterm_acc $bs (2 * $acc);

symbol bbterm (l : 𝕃 bool) : BV (size l) ≔ mkbv (size l) (bbterm_acc l 0);

// bit_of m : extract the bit at position m (0 = MSB, n−1 = LSB) per Alethe.
// Internally that is bit (n − 1 − m) when counting from the LSB of the
// canonical Z value, so we delegate to Nat-level testbit. The width-minus
// position helper has explicit ℕ-typed binders so that the `−` resolves
// unambiguously to Nat subtraction (Z is also in scope after `open Z`).

symbol bit_idx (n m : ℕ) : ℕ ≔ (Stdlib.Nat.- n m) ∸1;

symbol bit_of [n : τ nat] (m : τ nat) : BV n → 𝔹;
rule @bit_of $n $m (MVBV _ $x) ↪ testbit (to_nat $x) (bit_idx $n $m);

// ----------------------------------------------------------------------
// Additional bitvector operations needed by the Alethe bit-blasting rules
// ----------------------------------------------------------------------

// `bvxor` — SMT-LIB-aligned, via Nat's bitwise `xor`.
symbol bvxor [n : τ nat] : BV n → BV n → BV n;
rule @bvxor $n (MVBV _ $x) (MVBV _ $y) ↪
  mkbv $n (to_int (Stdlib.Nat.xor (to_nat $x) (to_nat $y)));

symbol bvxnor [n : τ nat] : BV n → BV n → BV n;
rule @bvxnor $n $x $y ↪ bvnot (bvxor $x $y);

// `bveq` — SMT-LIB-aligned: bitvector equality is value equality of
// the canonical ℤ representatives.
symbol bveq [n : τ nat] : BV n → BV n → 𝔹;
rule @bveq $n (MVBV _ $x) (MVBV _ $y) ↪ isEq ($x ≐ $y);

// Concatenation (SMT-LIB convention: first arg is higher / MSB-side).
symbol bvconcat [n m : τ nat] : BV n → BV m → BV (Stdlib.Nat.+ n m);
rule @bvconcat $n $m (MVBV _ $x) (MVBV _ $y) ↪
  mkbv (Stdlib.Nat.+ $n $m) ($x * (2 ^ (to_int $m)) + $y);

// Alethe-style extract j i x with i ≤ j: bits at MSB-first positions
// i..j (inclusive) of x. Result has width j − i + 1. In the canonical
// ℤ representation that corresponds to LSB-positions n−1−j … n−1−i, so
// the value is ⌊x / 2^(n−1−j)⌋ mod 2^(j−i+1).
symbol extract_width (j i : ℕ) : ℕ ≔ (Stdlib.Nat.- j i) +1;
symbol bvextract (j i : τ nat) [n : τ nat] : BV n → BV (extract_width j i);
rule @bvextract $j $i $n (MVBV _ $x) ↪
  mkbv (extract_width $j $i) (div $x (2 ^ (to_int (Stdlib.Nat.- ($n ∸1) $j))));

// ----------------------------------------------------------------------
// Bridge helpers: bits_of, bbT, zip_with
// ----------------------------------------------------------------------

// bits_of x : MSB-first list of x's bits, length n. Built by reading
// testbit at decreasing LSB-positions n−1, n−2, …, 0.
// (We use Nat's `_0` rather than the literal `0`, which resolves to Z's
// `Z0` because `Stdlib.Z` is opened.)
symbol bits_of_n : ℕ → τ int → 𝕃 bool;
rule bits_of_n _0      _   ↪ □
with bits_of_n ($k +1) $v  ↪ testbit (to_nat $v) $k ⸬ bits_of_n $k $v;

symbol bits_of [n : τ nat] : BV n → 𝕃 bool;
rule @bits_of $n (MVBV _ $v) ↪ bits_of_n $n $v;

// bbT n l : width-explicit packing, BV n directly. Differs from `bbterm`
// in that the result width is given by the user; the integer value is
// the same fold as bbterm, then taken mod 2ⁿ via mkbv.
symbol bbT (n : τ nat) (l : 𝕃 bool) : BV n ≔ mkbv n (bbterm_acc l 0);

// `bvnot` rule — fires here, *after* `bits_of` and `bbT` are in scope.
// Unconditional: it matches any BV n argument (not just MVBV-headed
// ones), so `bvnot x` and `bbT n (map not (bits_of x))` are
// definitionally equal for every x. This is what makes `bitblast_not`
// hold by `reflexivity`.
rule @bvnot $n $x ↪ bbT $n (map not (bits_of $x));

// zip_with : pointwise binary operation on two lists.
symbol zip_with [a b c] : (τ a → τ b → τ c) → 𝕃 a → 𝕃 b → 𝕃 c;
rule zip_with _ □              _                  ↪ □
with zip_with _ (_ ⸬ _)        □                  ↪ □
with zip_with $f ($x ⸬ $xs)   ($y ⸬ $ys)         ↪ $f $x $y ⸬ zip_with $f $xs $ys;

// ----------------------------------------------------------------------
// List-level bit-blasting functions (the right-hand sides of the rules)
// ----------------------------------------------------------------------
// We define each rule's RHS as a Lambdapi function on bool-lists. Each
// `bitblast_*` theorem below then says: the corresponding BV operation
// is equal (via `bbT`) to this list-level computation on the bits.
// Wrapping the binary Bool operators in named symbols (rather than using
// them as infix-applied-prefix) avoids ambiguity with the Nat versions
// of `xor`, with `and`/`or` parsing in prefix position, etc.

symbol bb_and (a b : 𝔹) : 𝔹 ≔ a and b;
symbol bb_or  (a b : 𝔹) : 𝔹 ≔ a or  b;
symbol bb_xor (a b : 𝔹) : 𝔹 ≔ Stdlib.Bool.xor a b;
symbol bb_iff (a b : 𝔹) : 𝔹 ≔ not (Stdlib.Bool.xor a b);
symbol bb_id  (a   : 𝔹) : 𝔹 ≔ a;

// `bvand`/`bvor`/`bvxor`/`bveq` rules left in their SMT-LIB-aligned
// arithmetic form above (around line 80) — they are *not* redefined
// here as `bbT n ∘ zip_with …`, because doing so would make each
// `bitblast_*` equation hold by `reflexivity`, which is not a real
// proof. Instead, the `bitblast_*` equations below are genuine
// theorems about the connection between Nat-bitwise / ≐-based ops
// and their bit-list expansions.

// ----------------------------------------------------------------------
// The Alethe bit-blasting rules (admitted)
// ----------------------------------------------------------------------
// Each rule states that a bitvector operation reduces to a `bbT` of a
// list-level computation on the bits of its operands. Proofs are
// admitted: they would require induction on n plus arithmetic lemmas
// on `mod 2ⁿ` and `testbit`, which is out of scope here.

// Rule 111: bitblast_not — provable by reflexivity now that `bvnot`
// is *defined* as `bbT n ∘ map not ∘ bits_of`. Both sides of the
// equation are syntactically equal after the bvnot rule fires.
//
// (An earlier draft tried to prove this by case-splitting `x` on
// `MVBV n v` via a `BV_elim` axiom and reducing to an arithmetic
// identity `bvnot_bits_arith`. That identity turns out to be FALSE
// for non-canonical `MVBV n v` — e.g. `v = −1, n = 2` gives LHS = 0
// but RHS = 3 — so the structured proof relied on an unprovable
// lemma. Redefining `bvnot` directly via the bit-list operations
// makes the whole question vanish.)
opaque symbol bitblast_not [n : τ nat] (x : BV n) :
  π (bvnot x = bbT n (map not (bits_of x))) ≔
begin reflexivity end;

// ----------------------------------------------------------------------
// Real proof of Rule 107 (bitblast_and)
// ----------------------------------------------------------------------

// (1) BV elimination axiom.  Not derivable in-system because `BV` is
// declared as a primitive symbol rather than as an inductive type, but
// admissible by the congruence-type semantics (§4.1 of Barthe–Geuvers,
// CSL'95): every term of type BV n is convertible to MVBV n v for some
// v : ℤ, so to prove P(x) for every x : BV n it suffices to prove
// P(MVBV n v) for every v.
symbol BV_elim [n : τ nat] (P : BV n → Prop) :
  (Π v : τ int, π (P (MVBV n v))) → Π x : BV n, π (P x);

// (2) Supporting lemmas for the arithmetic key lemma.
// ----------------------------------------------------------------------

// `pow2_nat n` is 2^n with the recursion on ℕ (not via `power_pos` on
// ℙ as in `Z.^`). It is definitionally equal to its successor doubling,
// which makes the `bbterm_acc_shift` lemma below tractable.
symbol pow2_nat : ℕ → τ int;
rule pow2_nat _0      ↪ 1
with pow2_nat ($n +1) ↪ 2 * pow2_nat $n;

// Helper: pos_div_eucl p 1 has remainder 0, for every positive p.
// Pos constructors are declared in the order I, O, H — induction goes
// in that order.
opaque symbol pos_div_eucl_mod_one (p : ℙ) :
  π ((pos_div_eucl p (Zpos H)) ₂ = 0) ≔
begin
  induction
  // case I p1 (i.e. 2·p1 + 1)
  { assume p1 IHp1;
    simplify;
    rewrite IHp1;
    reflexivity }
  // case O p1 (i.e. 2·p1)
  { assume p1 IHp1;
    simplify;
    rewrite IHp1;
    reflexivity }
  // case H
  { reflexivity }
end;

// Lemma: a mod 1 = 0 for any integer a.
opaque symbol modulo_one (a : τ int) : π (modulo a 1 = 0) ≔
begin
  induction
  // case Z0
  { reflexivity }
  // case Zpos p
  { assume p; refine pos_div_eucl_mod_one p }
  // case Zneg p — relies on pos_div_eucl_mod_one to discharge the inner `if`.
  { assume p;
    simplify;
    rewrite pos_div_eucl_mod_one p;
    reflexivity }
end;

// Two purely-arithmetic Z identities we need below.
//   arith_true : (2c+1)*b + acc = c*(2*b) + (1*b + acc)
//   arith_false: (2c)*b   + acc = c*(2*b) + (0*b + acc)
// These are pure Z lemmas — no list / bbterm content — and let us
// finish the `bbterm_acc_shift` inductive step in two `refine` calls.
opaque symbol arith_true (c b acc : τ int) :
  π ((2 * c + 1) * b + acc = c * (2 * b) + (1 * b + acc)) ≔
begin
  assume c b acc;
  rewrite *_com (2 * c + 1) b;
  rewrite *_distr_+ b (2 * c) 1;
  rewrite *_neutral b;
  rewrite *_com b (2 * c);
  rewrite *_com 1 b;
  rewrite *_neutral b;
  rewrite left *_assoc c 2 b;
  rewrite *_com c 2;
  rewrite +_assoc;
  reflexivity
end;

opaque symbol arith_false (c b acc : τ int) :
  π ((2 * c) * b + acc = c * (2 * b) + (0 * b + acc)) ≔
begin
  assume c b acc;
  rewrite *_com 2 c;
  rewrite *_assoc c 2 b;
  rewrite *_com 0 b;
  rewrite *_cancel b;
  reflexivity
end;

// Lemma: bbterm_acc commutes with its accumulator up to a power-of-2 shift.
//   bbterm_acc bs c = c * pow2_nat (size bs) + bbterm_acc bs 0.
// Proof: induction on bs.  We do NOT `assume c` before induction so
// that the IH is quantified over c (we need to use it with two
// different accumulators in each step).
opaque symbol bbterm_acc_shift (bs : 𝕃 bool) (c : τ int) :
  π (bbterm_acc bs c = c * pow2_nat (size bs) + bbterm_acc bs 0) ≔
begin
  induction
  // case □: bbterm_acc □ c = c, RHS = c * 1 + 0 = c, by *_neutral.
  { assume c;
    symmetry;
    refine *_neutral c }
  // case b ⸬ rest.  b is a 𝔹, so we case-split with ind_𝔹_eq.
  { assume b rest IH c;
    refine ind_𝔹_eq
      (λ b', bbterm_acc (b' ⸬ rest) c
            = c * pow2_nat (size (b' ⸬ rest)) + bbterm_acc (b' ⸬ rest) 0)
      b _ _
    // b = true
    { assume Hb;
      rewrite Hb;
      refine ind_eq (IH (2 * c + 1))
        (λ z, z = c * pow2_nat (size (true ⸬ rest)) + bbterm_acc (true ⸬ rest) 0)
        _;
      refine ind_eq (IH 1)
        (λ z, (2 * c + 1) * pow2_nat (size rest) + bbterm_acc rest 0
            = c * pow2_nat (size (true ⸬ rest)) + z)
        _;
      simplify;
      refine arith_true c (pow2_nat (size rest)) (bbterm_acc rest 0) }
    // b = false
    { assume Hb;
      rewrite Hb;
      refine ind_eq (IH (2 * c))
        (λ z, z = c * pow2_nat (size (false ⸬ rest)) + bbterm_acc (false ⸬ rest) 0)
        _;
      refine ind_eq (IH 0)
        (λ z, (2 * c) * pow2_nat (size rest) + bbterm_acc rest 0
            = c * pow2_nat (size (false ⸬ rest)) + z)
        _;
      simplify;
      refine arith_false c (pow2_nat (size rest)) (bbterm_acc rest 0) } }
end;

// Size lemmas — straightforward inductions used by the main lemma below.

opaque symbol size_bits_of_n (n : ℕ) (v : τ int) :
  π (size (bits_of_n n v) = n) ≔
begin
  induction
  { assume v; reflexivity }
  { assume k IH v;
    simplify;
    rewrite IH v;
    reflexivity }
end;

opaque symbol size_zip_with_bb_and (n : ℕ) (vx vy : τ int) :
  π (size (zip_with bb_and (bits_of_n n vx) (bits_of_n n vy)) = n) ≔
begin
  induction
  { assume vx vy; reflexivity }
  { assume k IH vx vy;
    refine feq (+1) (IH vx vy) }
end;

// (2a) power_pos_succ : power_pos x (succ p) = x * power_pos x p
opaque symbol power_pos_succ (x : ℤ) (p : ℙ) :
  π (power_pos x (Stdlib.Pos.succ p) = x * power_pos x p) ≔
begin
  assume x;
  induction
  // case I p1: succ (I p1) = O (succ p1)
  { assume p1 IH;
    simplify;
    rewrite IH;
    rewrite *_assoc x (power_pos x p1) (x * power_pos x p1);
    rewrite *_com (power_pos x p1) (x * power_pos x p1);
    rewrite *_assoc x (power_pos x p1) (power_pos x p1);
    reflexivity }
  // case O p1: succ (O p1) = I p1
  { assume p1 IH;
    simplify;
    reflexivity }
  // case H
  { simplify; reflexivity }
end;

// (2b) pow2_succ : 2^to_int (k+1) = 2 * 2^to_int k
opaque symbol pow2_succ (k : ℕ) :
  π ((2 ^ (to_int (k +1))) = 2 * (2 ^ (to_int k))) ≔
begin
  induction
  // case k = _0
  { reflexivity }
  // case k = j+1
  { assume j IH;
    refine power_pos_succ 2 (of_succ_nat j) }
end;

// (2c) pow2_nat_eq : pow2_nat n = 2^to_int n
opaque symbol pow2_nat_eq (n : ℕ) :
  π (pow2_nat n = (2 ^ (to_int n))) ≔
begin
  induction
  // case n = _0
  { reflexivity }
  // case n = k+1
  { assume k IH;
    simplify;
    rewrite IH;
    symmetry;
    refine pow2_succ k }
end;

// Tiny helper: 0 * x = 0 in Z.  (Z.lp has *_cancel : x * 0 = 0 only.)
opaque symbol Z0_*_l (x : ℤ) : π (Z0 * x = Z0) ≔
begin
  assume x; rewrite *_com Z0 x; refine *_cancel x
end;

// (2d) pow2_nat_pos : 0 < pow2_nat n
opaque symbol pow2_nat_pos (n : ℕ) :
  π (Z0 < pow2_nat n) ≔
begin
  induction
  // case n = _0: pow2_nat _0 = 1, and 0 < 1 reduces to ⊤.
  { simplify; refine ⊤ᵢ }
  // case n = k+1: pow2_nat (k+1) = 2 * pow2_nat k.
  // Use mul_lt_mono_pos_l with p = pow2_nat k: 0 < 2 ⇔ 0*p < 2*p.
  { assume k IH;
    simplify;
    have H1 : π (Z0 < 2 ⇔ Z0 * pow2_nat k < 2 * pow2_nat k)
    { refine mul_lt_mono_pos_l (pow2_nat k) IH Z0 2 };
    have H2 : π (Z0 < 2) { refine ⊤ᵢ };
    have H3 : π (Z0 * pow2_nat k < 2 * pow2_nat k) { refine ∧ₑ₁ H1 H2 };
    rewrite left Z0_*_l (pow2_nat k);
    refine H3 }
end;

// ----------------------------------------------------------------------
// Comp ↔ order conversion helpers (not in Z.lp).  Each one is a 3-case
// `ind_Comp`/`induction` argument on the comparison value.
// ----------------------------------------------------------------------

// isLe c = true ⇒ ¬ (isGt c = true).  Pure Comp lemma.
opaque symbol isLe_neg_isGt (c : Comp) :
  π (isLe c = true) → π (isGt c = true) → π ⊥ ≔
begin
  induction
  // case Eq: isGt Eq = false, but hyp says it's true → false=true.
  { assume Hle Hgt; refine false≠true Hgt }
  // case Lt: same.
  { assume Hle Hgt; refine false≠true Hgt }
  // case Gt: isLe Gt = false, but hyp says it's true.
  { assume Hle Hgt; refine false≠true Hle }
end;

// isLe (x ≐ y) = true ⇒ x ≤ y.
opaque symbol isLe_to_le (x y : ℤ) :
  π (isLe (x ≐ y) = true) → π (x ≤ y) ≔
begin
  assume x y Hle Hgt;
  refine isLe_neg_isGt (x ≐ y) Hle (istrue=true Hgt)
end;

// isLe c = false ⇒ c = Gt.
opaque symbol not_isLe_implies_Gt (c : Comp) :
  π (isLe c = false) → π (c = Gt) ≔
begin
  induction
  // case Eq: isLe Eq = true, contradicts hyp.
  { assume Hle; refine ⊥ₑ (true≠false Hle) }
  // case Lt: isLe Lt = true, contradicts hyp.
  { assume Hle; refine ⊥ₑ (true≠false Hle) }
  // case Gt: result is reflexivity.
  { assume Hle; reflexivity }
end;

// isLe (x ≐ y) = false ⇒ y < x.
opaque symbol not_isLe_to_lt (x y : ℤ) :
  π (isLe (x ≐ y) = false) → π (y < x) ≔
begin
  assume x y Hnle;
  have Hgt : π ((x ≐ y) = Gt) { refine not_isLe_implies_Gt (x ≐ y) Hnle };
  // y < x := istrue (isLt (y ≐ x)).
  simplify;
  // goal: istrue (isLt (y ≐ x))
  rewrite ≐_com y x;
  // goal: istrue (isLt (opp (x ≐ y)))
  rewrite Hgt;
  // goal: istrue (isLt (opp Gt)) = istrue (isLt Lt) = ⊤
  refine ⊤ᵢ
end;

// Helper: in the H base case we need to know Z0 < b implies b is Zpos q for some q.
// This isn't needed if we instead case-analyse on b directly in the proof.

// Helper: 1 ≤ 2 in ℤ (used to derive 1 < b from 2 ≤ b).
opaque symbol Z1_lt_2 : π (Zpos H < 2) ≔
begin refine ⊤ᵢ end;

// Helper: Zpos (I q) is at least 3, so never < 2.  Proof by induction on q —
// in every sub-case `compare_acc (I q) Eq (O H)` reduces to Gt, so the
// hypothesis is convertible to π ⊥.
opaque symbol Z_pos_I_not_lt_2 (q : ℙ) : π (Zpos (I q) < 2) → π ⊥ ≔
begin
  induction
  { assume qq IH H; refine H }
  { assume qq IH H; refine H }
  { assume H; refine H }
end;

// Helper: Zpos (O q) is at least 2, so never < 2.
opaque symbol Z_pos_O_not_lt_2 (q : ℙ) : π (Zpos (O q) < 2) → π ⊥ ≔
begin
  induction
  { assume qq IH H; refine H }
  { assume qq IH H; refine H }
  { assume H; refine H }
end;

// Helper: 0 ≤ r implies 0 ≤ 2*r.  By case analysis on r.
// (2 * Z0 = Z0, 2 * Zpos p = Zpos (O p), and Zneg case is excluded by 0 ≤ r.)
opaque symbol Z_nonneg_mul_2 (r : ℤ) : π (Z0 ≤ r) → π (Z0 ≤ 2 * r) ≔
begin
  induction
  // case Z0:  2 * Z0 = Z0;  0 ≤ 0 = ¬ ⊥ = ⊥ → ⊥.
  { assume H0 Hgt; refine Hgt }
  // case Zpos p:  2 * Zpos p = Zpos (O p);  0 ≤ Zpos (O p) = ¬ ⊥ = ⊥ → ⊥.
  { assume p H0 Hgt; refine Hgt }
  // case Zneg p:  0 ≤ Zneg p is ¬ ⊤, applied to ⊤ᵢ gives ⊥.
  { assume p H0; refine ⊥ₑ (H0 ⊤ᵢ) }
end;

// Right-distributivity of * over +.  Derived from *_com and *_distr_+.
opaque symbol Z_distr_+_r (x y z : ℤ) : π ((x + y) * z = x * z + y * z) ≔
begin
  assume x y z;
  rewrite *_com (x + y) z;
  rewrite *_distr_+ z x y;
  rewrite *_com z x;
  rewrite *_com z y;
  reflexivity
end;

// 1 * b = b.  Uses *_com and *_neutral.
opaque symbol Z_1_mul_l (b : ℤ) : π ((Zpos H) * b = b) ≔
begin
  assume b; rewrite *_com (Zpos H) b; refine *_neutral b
end;

// Pure Comp lemma: if isLt c = false and isGt (opp c) = true, then ⊥.
opaque symbol Comp_isLt_false_isGt_opp_contradicts (c : Comp) :
  π (isLt c = false) → π (isGt (opp c) = true) → π ⊥ ≔
begin
  induction
  // case Eq: H2 : false = true (after reduction).
  { assume H1 H2; refine false≠true H2 }
  // case Lt: H1 : true = false (after reduction); flip with eq_sym.
  { assume H1 H2; refine false≠true (eq_sym H1) }
  // case Gt: H2 : false = true.
  { assume H1 H2; refine false≠true H2 }
end;

// isLt (x ≐ y) = false → y ≤ x.
opaque symbol isLt_false_to_le (x y : ℤ) :
  π (isLt (x ≐ y) = false) → π (y ≤ x) ≔
begin
  assume x y Hnlt Hgt;
  // Hgt : istrue (isGt (y ≐ x)).  Convert to isGt (opp (x ≐ y)) = true via ≐_com.
  have H1 : π (isGt (y ≐ x) = true) { refine istrue=true Hgt };
  have H2 : π (isGt (opp (x ≐ y)) = true)
    { refine ind_eq (eq_sym (≐_com y x)) (λ c, isGt c = true) H1 };
  refine Comp_isLt_false_isGt_opp_contradicts (x ≐ y) Hnlt H2
end;

// Mutual fact about Pos arithmetic: add p p = O p and add_carry p p = I p.
opaque symbol Pos_add_double_facts (p : ℙ) :
  π ((Stdlib.Pos.add p p = O p) ∧ (Stdlib.Pos.add_carry p p = I p)) ≔
begin
  induction
  // case I q
  { assume q IH;
    refine ∧ᵢ _ _
    { simplify; refine feq O (∧ₑ₂ IH) }
    { simplify; refine feq I (∧ₑ₂ IH) } }
  // case O q
  { assume q IH;
    refine ∧ᵢ _ _
    { simplify; refine feq O (∧ₑ₁ IH) }
    { simplify; refine feq I (∧ₑ₁ IH) } }
  // case H
  { refine ∧ᵢ _ _
    { reflexivity }
    { reflexivity } }
end;

// 2 * b = b + b in ℤ.  By case on b; each case reduces via Z's + and *.
opaque symbol Z_2_mul_eq_b_plus_b (b : ℤ) :
  π ((Zpos (O H)) * b = b + b) ≔
begin
  induction
  // case Z0
  { reflexivity }
  // case Zpos p:  2 * Zpos p = Zpos (O p);  Zpos p + Zpos p = Zpos (add p p) = Zpos (O p).
  { assume p; refine feq Zpos (eq_sym (∧ₑ₁ (Pos_add_double_facts p))) }
  // case Zneg p:  similar.
  { assume p; refine feq Zneg (eq_sym (∧ₑ₁ (Pos_add_double_facts p))) }
end;

// 2 * b - b = b.  From Z_2_mul_eq_b_plus_b and -_same.
opaque symbol Z_2b_minus_b_eq_b (b : ℤ) :
  π ((Zpos (O H)) * b + (— b) = b) ≔
begin
  assume b;
  rewrite Z_2_mul_eq_b_plus_b b;
  rewrite +_assoc;
  rewrite -_same;
  reflexivity
end;

// r < b → r + 1 ≤ b.  Integer-step lemma (via Z.lp's _ax4 and ≤_≥).
opaque symbol Z_lt_implies_succ_le (r b : ℤ) :
  π (r < b) → π (r + Zpos H ≤ b) ≔
begin
  assume r b Hrb;
  refine ∧ₑ₁ (≤_≥ b (r + Zpos H)) _;
  refine _ax4 b r (<_neg_≤ r b Hrb) Hrb
end;

// r < b → 2*r + 1 < 2*b.  Combines mul_lt_mono with integer-step.
opaque symbol Z_r_lt_b_2r1_lt_2b (r b : ℤ) :
  π (r < b) → π ((Zpos (O H)) * r + Zpos H < (Zpos (O H)) * b) ≔
begin
  assume r b Hrb;
  // Step 1: r + 1 ≤ b.
  have Hr1_le_b : π (r + Zpos H ≤ b) { refine Z_lt_implies_succ_le r b Hrb };
  // Step 2: r + (r+1) < b + (r+1).
  have H1 : π (r + (r + Zpos H) < b + (r + Zpos H))
    { refine <_compat_add r b (r + Zpos H) Hrb };
  // Step 3: (r+1) + b ≤ b + b.
  have H2 : π ((r + Zpos H) + b ≤ b + b)
    { refine ≤_compat_add (r + Zpos H) b b Hr1_le_b };
  // Transform H2 LHS via +_com: b + (r+1) ≤ b + b.
  have H3 : π (b + (r + Zpos H) ≤ b + b)
    { refine ind_eq (+_com b (r + Zpos H)) (λ z, z ≤ b + b) H2 };
  // Combine: r + (r+1) < b + b via <_trans_1.
  have H4 : π (r + (r + Zpos H) < b + b)
    { refine <_trans_1 (r + (r + Zpos H)) (b + (r + Zpos H)) (b + b) H1 H3 };
  // 2*r + 1 = r + (r + 1).
  have Hrr : π (Zpos (O H) * r + Zpos H = r + (r + Zpos H))
    { rewrite Z_2_mul_eq_b_plus_b r;
      rewrite +_assoc;
      reflexivity };
  // Transform LHS of H4: 2*r + 1 < b + b.
  have H5 : π (Zpos (O H) * r + Zpos H < b + b)
    { refine ind_eq Hrr (λ z, z < b + b) H4 };
  // Transform RHS: b + b → 2 * b.
  refine ind_eq (Z_2_mul_eq_b_plus_b b)
    (λ z, Zpos (O H) * r + Zpos H < z) H5
end;

// b + (2*r + —b) = 2*r.  Pure Z arithmetic (with `-` unfolded for syntactic
// matching after the surrounding `simplify`).  Uses `Zpos (O H)` instead of
// the literal `2` so the rewrite pattern matches the post-simplify goal form.
opaque symbol Z_b_plus_diff (b r : ℤ) :
  π (b + ((Zpos (O H)) * r + — b) = (Zpos (O H)) * r) ≔
begin
  assume b r;
  rewrite left +_assoc;
  rewrite +_com b;
  rewrite +_assoc;
  rewrite -_same;
  reflexivity
end;

// Generalization of Z_b_plus_diff: b + (x + —b) = x for any x.
opaque symbol Z_b_plus_x_minus_b (b x : ℤ) : π (b + (x + — b) = x) ≔
begin
  assume b x;
  rewrite left +_assoc;
  rewrite +_com b;
  rewrite +_assoc;
  rewrite -_same;
  reflexivity
end;

// Helper: positive integer b strictly below 2 must be 1.
// Used in the FALSE branch of the H case of pos_div_eucl_correct.
opaque symbol Z_pos_lt_2_eq_one (b : ℤ) :
  π (Z0 < b) → π (b < 2) → π (b = Zpos H) ≔
begin
  induction
  // case b = Z0:  0 < 0  is ⊥.
  { assume H0 H2; refine ⊥ₑ H0 }
  // case b = Zpos q:  induct on q.
  { induction
    // case q = I qq.
    { assume qq IH H0 H2; refine ⊥ₑ (Z_pos_I_not_lt_2 qq H2) }
    // case q = O qq.
    { assume qq IH H0 H2; refine ⊥ₑ (Z_pos_O_not_lt_2 qq H2) }
    // case q = H.
    { assume H0 H2; reflexivity } }
  // case b = Zneg q:  0 < Zneg q  is ⊥.
  { assume q H0 H2; refine ⊥ₑ H0 }
end;

// (2e) pos_div_eucl_correct : the key Euclidean correctness theorem.
// For any positive p : ℙ and positive divisor b : ℤ,
//   • Zpos p = q * b + r           (Euclidean equation)
//   • 0 ≤ r                         (non-negativity of remainder)
//   • r < b                         (boundedness of remainder)
// where (q, r) = pos_div_eucl p b.  Proof by induction on p in I/O/H order.
opaque symbol pos_div_eucl_correct (p : ℙ) (b : ℤ) :
  π (Z0 < b)
    → π ((Zpos p = ((pos_div_eucl p b) ₁) * b + ((pos_div_eucl p b) ₂))
       ∧ (Z0 ≤ ((pos_div_eucl p b) ₂))
       ∧ (((pos_div_eucl p b) ₂) < b)) ≔
begin
  induction
  // case I p1.  Same structure as O p1 but with `2*r + 1` instead of `2*r`,
  // and Zpos (I p1) instead of Zpos (O p1).
  { assume p1 IH b Hb;
    have IHb : π ((Zpos p1 = ((pos_div_eucl p1 b)₁) * b + ((pos_div_eucl p1 b)₂))
                ∧ (Z0 ≤ ((pos_div_eucl p1 b)₂))
                ∧ (((pos_div_eucl p1 b)₂) < b))
      { refine IH b Hb };
    have Eq_p1 : π (Zpos p1 = ((pos_div_eucl p1 b)₁) * b + ((pos_div_eucl p1 b)₂))
      { refine ∧ₑ₁ IHb };
    have R_nonneg : π (Z0 ≤ ((pos_div_eucl p1 b)₂))
      { refine ∧ₑ₁ (∧ₑ₂ IHb) };
    have R_lt_b : π (((pos_div_eucl p1 b)₂) < b)
      { refine ∧ₑ₂ (∧ₑ₂ IHb) };
    refine ind_𝔹_eq
      (λ bv, ((Zpos (I p1)
            = ((if bv
                  ((Zpos (O H) * ((pos_div_eucl p1 b)₁)) ‚ (Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H))
                  ((Zpos (O H) * ((pos_div_eucl p1 b)₁) + Zpos H) ‚ ((Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H) - b)))₁) * b
            + ((if bv
                  ((Zpos (O H) * ((pos_div_eucl p1 b)₁)) ‚ (Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H))
                  ((Zpos (O H) * ((pos_div_eucl p1 b)₁) + Zpos H) ‚ ((Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H) - b)))₂))
         ∧ (Z0 ≤ ((if bv
                     ((Zpos (O H) * ((pos_div_eucl p1 b)₁)) ‚ (Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H))
                     ((Zpos (O H) * ((pos_div_eucl p1 b)₁) + Zpos H) ‚ ((Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H) - b)))₂))
         ∧ (((if bv
                ((Zpos (O H) * ((pos_div_eucl p1 b)₁)) ‚ (Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H))
                ((Zpos (O H) * ((pos_div_eucl p1 b)₁) + Zpos H) ‚ ((Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H) - b)))₂) < b)))
      (isLt (((Zpos (O H)) * ((pos_div_eucl p1 b)₂) + Zpos H) ≐ b))
      _ _
    // TRUE branch: 2*r + 1 < b. Result pair (2*q, 2*r + 1).
    { assume Htrue;
      rewrite Htrue;
      simplify;
      refine ∧ᵢ _ (∧ᵢ _ _)
      // Goal 1: Zpos (I p1) = (2*q)*b + (2*r + 1)
      { symmetry;
        rewrite left +_assoc;
        rewrite *_assoc (Zpos (O H)) ((pos_div_eucl p1 b)₁) b;
        rewrite left *_distr_+ (Zpos (O H)) (((pos_div_eucl p1 b)₁) * b) ((pos_div_eucl p1 b)₂);
        rewrite left Eq_p1;
        reflexivity }
      // Goal 2: 0 ≤ 2*r + 1
      { refine ≤_compat_≤ ((Zpos (O H)) * ((pos_div_eucl p1 b)₂)) (Zpos H)
                          (Z_nonneg_mul_2 ((pos_div_eucl p1 b)₂) R_nonneg) _;
        assume Hgt; refine false≠true (istrue=true Hgt) }
      // Goal 3: 2*r + 1 < b
      { refine ind_eq Htrue (λ y, istrue y) ⊤ᵢ } }
    // FALSE branch: 2*r + 1 ≥ b. Result pair (2*q+1, 2*r + 1 - b).
    { assume Hfalse;
      rewrite Hfalse;
      simplify;
      refine ∧ᵢ _ (∧ᵢ _ _)
      // Goal 1: Zpos (I p1) = (2*q + 1)*b + (2*r + 1 - b)
      { symmetry;
        rewrite Z_distr_+_r ((Zpos (O H)) * ((pos_div_eucl p1 b)₁)) (Zpos H) b;
        rewrite Z_1_mul_l b;
        rewrite +_assoc;
        rewrite Z_b_plus_x_minus_b b ((Zpos (O H)) * ((pos_div_eucl p1 b)₂) + Zpos H);
        rewrite left +_assoc;
        rewrite *_assoc (Zpos (O H)) ((pos_div_eucl p1 b)₁) b;
        rewrite left *_distr_+ (Zpos (O H)) (((pos_div_eucl p1 b)₁) * b) ((pos_div_eucl p1 b)₂);
        rewrite left Eq_p1;
        reflexivity }
      // Goal 2: 0 ≤ 2*r + 1 - b
      { have Hle : π (b ≤ (Zpos (O H)) * ((pos_div_eucl p1 b)₂) + Zpos H)
          { refine isLt_false_to_le ((Zpos (O H)) * ((pos_div_eucl p1 b)₂) + Zpos H) b Hfalse };
        have Hsum : π (b + (— b) ≤ ((Zpos (O H)) * ((pos_div_eucl p1 b)₂) + Zpos H) + (— b))
          { refine ≤_compat_add b ((Zpos (O H)) * ((pos_div_eucl p1 b)₂) + Zpos H) (— b) Hle };
        rewrite left -_same b;
        refine Hsum }
      // Goal 3: 2*r + 1 - b < b.  From Z_r_lt_b_2r1_lt_2b: 2*r+1 < 2*b.
      // Subtract b from both sides via <_compat_add, then 2*b + —b = b.
      { have H2r1_lt_2b : π (Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H
                          < Zpos (O H) * b)
          { refine Z_r_lt_b_2r1_lt_2b ((pos_div_eucl p1 b)₂) b R_lt_b };
        have Hfinal : π ((Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H) + (— b)
                       < Zpos (O H) * b + (— b))
          { refine <_compat_add (Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H)
                                (Zpos (O H) * b) (— b) H2r1_lt_2b };
        refine ind_eq (eq_sym (Z_2b_minus_b_eq_b b))
          (λ z, (Zpos (O H) * ((pos_div_eucl p1 b)₂) + Zpos H) + (— b) < z)
          Hfinal } } }
  // case O p1.  Let (q, r) = pos_div_eucl p1 b.  By IH:
  //   Zpos p1 = q*b + r,  0 ≤ r,  r < b.
  // The pos_div_eucl rule reduces to:
  //   if (isLt (2*r ≐ b)) ((2*q, 2*r)) ((2*q+1, 2*r - b))
  // Case-split on the conditional.
  { assume p1 IH b Hb;
    have IHb : π ((Zpos p1 = ((pos_div_eucl p1 b)₁) * b + ((pos_div_eucl p1 b)₂))
                ∧ (Z0 ≤ ((pos_div_eucl p1 b)₂))
                ∧ (((pos_div_eucl p1 b)₂) < b))
      { refine IH b Hb };
    have Eq_p1 : π (Zpos p1 = ((pos_div_eucl p1 b)₁) * b + ((pos_div_eucl p1 b)₂))
      { refine ∧ₑ₁ IHb };
    have R_nonneg : π (Z0 ≤ ((pos_div_eucl p1 b)₂))
      { refine ∧ₑ₁ (∧ₑ₂ IHb) };
    have R_lt_b : π (((pos_div_eucl p1 b)₂) < b)
      { refine ∧ₑ₂ (∧ₑ₂ IHb) };
    refine ind_𝔹_eq
      (λ bv, ((Zpos (O p1)
            = ((if bv
                  ((2 * ((pos_div_eucl p1 b)₁)) ‚ (2 * ((pos_div_eucl p1 b)₂)))
                  ((2 * ((pos_div_eucl p1 b)₁) + 1) ‚ ((2 * ((pos_div_eucl p1 b)₂)) - b)))₁) * b
            + ((if bv
                  ((2 * ((pos_div_eucl p1 b)₁)) ‚ (2 * ((pos_div_eucl p1 b)₂)))
                  ((2 * ((pos_div_eucl p1 b)₁) + 1) ‚ ((2 * ((pos_div_eucl p1 b)₂)) - b)))₂))
         ∧ (Z0 ≤ ((if bv
                     ((2 * ((pos_div_eucl p1 b)₁)) ‚ (2 * ((pos_div_eucl p1 b)₂)))
                     ((2 * ((pos_div_eucl p1 b)₁) + 1) ‚ ((2 * ((pos_div_eucl p1 b)₂)) - b)))₂))
         ∧ (((if bv
                ((2 * ((pos_div_eucl p1 b)₁)) ‚ (2 * ((pos_div_eucl p1 b)₂)))
                ((2 * ((pos_div_eucl p1 b)₁) + 1) ‚ ((2 * ((pos_div_eucl p1 b)₂)) - b)))₂) < b)))
      (isLt ((2 * ((pos_div_eucl p1 b)₂)) ≐ b))
      _ _
    // TRUE branch: 2*r < b.  Result pair (2*q, 2*r).
    { assume Htrue;
      rewrite Htrue;
      simplify;
      refine ∧ᵢ _ (∧ᵢ _ _)
      // Goal 1: Zpos (O p1) = (2 * q) * b + 2 * r
      // Rewrite RHS to 2 * Zpos p1 via distributivity + IH.
      { symmetry;
        rewrite *_assoc (Zpos (O H)) ((pos_div_eucl p1 b)₁) b;
        rewrite left *_distr_+ (Zpos (O H)) (((pos_div_eucl p1 b)₁) * b) ((pos_div_eucl p1 b)₂);
        rewrite left Eq_p1;
        reflexivity }
      // Goal 2: 0 ≤ 2 * r
      { refine Z_nonneg_mul_2 ((pos_div_eucl p1 b)₂) R_nonneg }
      // Goal 3: 2 * r < b = istrue (isLt (2*r ≐ b)).
      // From Htrue : isLt (...) = true, use ind_eq with motive `istrue`.
      { refine ind_eq Htrue (λ y, istrue y) ⊤ᵢ } }
    // FALSE branch: 2*r ≥ b.  Result pair (2*q+1, 2*r - b).
    { assume Hfalse;
      rewrite Hfalse;
      simplify;  // unfold `if`, projections, and `-` to `+ —`
      refine ∧ᵢ _ (∧ᵢ _ _)
      // Goal 1: Zpos (O p1) = (2*q + 1) * b + (2*r - b)
      // Expand (2*q+1)*b = 2*q*b + b, then b + (2*r - b) = 2*r, then same chain as TRUE.
      { symmetry;
        rewrite Z_distr_+_r ((Zpos (O H)) * ((pos_div_eucl p1 b)₁)) (Zpos H) b;
        rewrite Z_1_mul_l b;
        rewrite +_assoc;
        rewrite Z_b_plus_diff b ((pos_div_eucl p1 b)₂);
        rewrite *_assoc (Zpos (O H)) ((pos_div_eucl p1 b)₁) b;
        rewrite left *_distr_+ (Zpos (O H)) (((pos_div_eucl p1 b)₁) * b) ((pos_div_eucl p1 b)₂);
        rewrite left Eq_p1;
        reflexivity }
      // Goal 2: 0 ≤ 2*r + —b.  From b ≤ 2*r, add —b to both sides via ≤_compat_add.
      { have Hle : π (b ≤ (Zpos (O H)) * ((pos_div_eucl p1 b)₂))
          { refine isLt_false_to_le ((Zpos (O H)) * ((pos_div_eucl p1 b)₂)) b Hfalse };
        have Hsum : π (b + (— b) ≤ (Zpos (O H)) * ((pos_div_eucl p1 b)₂) + (— b))
          { refine ≤_compat_add b ((Zpos (O H)) * ((pos_div_eucl p1 b)₂)) (— b) Hle };
        rewrite left -_same b;
        refine Hsum }
      // Goal 3: 2*r + —b < b.  From r < b, get 2*r < 2*b, subtract b on both
      // sides, then rewrite 2*b + —b = b.
      { have Hpos2 : π (Z0 < Zpos (O H)) { refine ⊤ᵢ };
        have Hiff : π (((pos_div_eucl p1 b)₂) < b
                     ⇔ ((pos_div_eucl p1 b)₂) * Zpos (O H) < b * Zpos (O H))
          { refine mul_lt_mono_pos_l (Zpos (O H)) Hpos2 ((pos_div_eucl p1 b)₂) b };
        have Hr2_lt_b2 : π (((pos_div_eucl p1 b)₂) * Zpos (O H) < b * Zpos (O H))
          { refine ∧ₑ₁ Hiff R_lt_b };
        // Convert r*2 < b*2 to 2*r < 2*b via *_com.
        have H_2r_lt_2b : π (Zpos (O H) * ((pos_div_eucl p1 b)₂) < Zpos (O H) * b)
          { refine ind_eq (*_com (Zpos (O H)) b)
              (λ z, Zpos (O H) * ((pos_div_eucl p1 b)₂) < z)
              (ind_eq (*_com (Zpos (O H)) ((pos_div_eucl p1 b)₂))
                (λ z, z < b * Zpos (O H))
                Hr2_lt_b2) };
        // Subtract b from both sides.
        have Hfinal : π (Zpos (O H) * ((pos_div_eucl p1 b)₂) + (— b)
                       < Zpos (O H) * b + (— b))
          { refine <_compat_add (Zpos (O H) * ((pos_div_eucl p1 b)₂))
                                (Zpos (O H) * b) (— b) H_2r_lt_2b };
        // Replace just the final `b` (the RHS of <) with 2*b + —b via ind_eq.
        refine ind_eq (eq_sym (Z_2b_minus_b_eq_b b))
          (λ z, Zpos (O H) * ((pos_div_eucl p1 b)₂) + (— b) < z)
          Hfinal } } }
  // case H
  { assume b Hb;
    // pos_div_eucl H b ↪ if (isLe (2 ≐ b)) (0,1) (1,0). Case-split.
    refine ind_𝔹_eq
      (λ bv, ((Zpos H = ((if bv (0 ‚ 1) (1 ‚ 0))₁) * b + ((if bv (0 ‚ 1) (1 ‚ 0))₂))
           ∧ (Z0 ≤ ((if bv (0 ‚ 1) (1 ‚ 0))₂))
           ∧ (((if bv (0 ‚ 1) (1 ‚ 0))₂) < b)))
      (isLe (2 ≐ b)) _ _
    // TRUE branch: pos_div_eucl H b reduces to (0,1) once we substitute the boolean.
    { assume Htrue;
      // The motive abstracts over bv, but bv is still `isLe (2 ≐ b)` in the goal.
      // Need this fact for the order tactics before we rewrite (which substitutes).
      have Hle2b : π (2 ≤ b) { refine isLe_to_le 2 b Htrue };
      rewrite Htrue;
      simplify;
      // After simplification: 1 = 1, 0 ≤ 1, 1 < b.
      refine ∧ᵢ _ (∧ᵢ _ _)
      { reflexivity }
      { assume Hgt; refine false≠true (istrue=true Hgt) }
      { refine <_trans_1 (Zpos H) 2 b Z1_lt_2 Hle2b } }
    // FALSE branch: pos_div_eucl H b reduces to (1,0), need b = 1.
    { assume Hfalse;
      have Hblt2 : π (b < 2) { refine not_isLe_to_lt 2 b Hfalse };
      have Hb1 : π (b = Zpos H) { refine Z_pos_lt_2_eq_one b Hb Hblt2 };
      rewrite Hfalse;
      refine ∧ᵢ _ (∧ᵢ _ _)
      { rewrite Hb1; reflexivity }
      { assume Hgt; refine false≠true (istrue=true Hgt) }
      { refine Hb } } }
end;

// (2f) modulo facts on top of pos_div_eucl_correct.
// ----------------------------------------------------------------------

// modulo Z0 M = Z0.  By div_eucl rule  div_eucl Z0 _ ↪ (0, 0).
opaque symbol mod_Z0 (M : ℤ) : π (modulo Z0 M = Z0) ≔
begin assume M; reflexivity end;

// modulo (Zpos p) (Zpos m) = (pos_div_eucl p (Zpos m))₂.  Direct from div_eucl rule.
opaque symbol mod_Zpos_Zpos (p m : ℙ) :
  π (modulo (Zpos p) (Zpos m) = ((pos_div_eucl p (Zpos m))₂)) ≔
begin assume p m; reflexivity end;

// 0 ≤ modulo X M  for X ≥ 0 and M > 0.
opaque symbol mod_nonneg (X M : ℤ) :
  π (Z0 ≤ X) → π (Z0 < M) → π (Z0 ≤ modulo X M) ≔
begin
  induction
  // X = Z0
  { assume M H0X HposM; rewrite mod_Z0 M; refine H0X }
  // X = Zpos p — further case on M to extract Zpos m.
  { assume p;
    induction
    { assume H0X Hbot; refine ⊥ₑ Hbot }
    { assume m H0X HposM;
      rewrite mod_Zpos_Zpos p m;
      refine ∧ₑ₁ (∧ₑ₂ (pos_div_eucl_correct p (Zpos m) HposM)) }
    { assume m H0X Hbot; refine ⊥ₑ Hbot } }
  // X = Zneg p: ⊥
  { assume p M H0X HposM; refine ⊥ₑ (H0X ⊤ᵢ) }
end;

// modulo X M < M  for X ≥ 0 and M > 0.
opaque symbol mod_lt (X M : ℤ) :
  π (Z0 ≤ X) → π (Z0 < M) → π (modulo X M < M) ≔
begin
  induction
  // X = Z0
  { assume M H0X HposM; rewrite mod_Z0 M; refine HposM }
  // X = Zpos p
  { assume p;
    induction
    { assume H0X Hbot; refine ⊥ₑ Hbot }
    { assume m H0X HposM;
      rewrite mod_Zpos_Zpos p m;
      refine ∧ₑ₂ (∧ₑ₂ (pos_div_eucl_correct p (Zpos m) HposM)) }
    { assume m H0X Hbot; refine ⊥ₑ Hbot } }
  // X = Zneg p: ⊥
  { assume p M H0X HposM; refine ⊥ₑ (H0X ⊤ᵢ) }
end;

// div (Zpos p) (Zpos m) = (pos_div_eucl p (Zpos m))₁.  Direct from div_eucl rule.
opaque symbol div_Zpos_Zpos (p m : ℙ) :
  π (div (Zpos p) (Zpos m) = ((pos_div_eucl p (Zpos m))₁)) ≔
begin assume p m; reflexivity end;

// ----------------------------------------------------------------------
// Helpers for mod_unique: cancellation/bound arguments.
// ----------------------------------------------------------------------

// Comp lemma: isLt (opp c) = isGt c, for any c.
opaque symbol Comp_isLt_opp (c : Comp) : π (isLt (opp c) = isGt c) ≔
begin
  induction
  { reflexivity }
  { reflexivity }
  { reflexivity }
end;

// isGt (x ≐ y) = true → y < x.  (The strict reverse of the isLt_false_to_le pattern.)
opaque symbol isGt_true_implies_lt (x y : ℤ) :
  π (isGt (x ≐ y) = true) → π (y < x) ≔
begin
  assume x y Hgt;
  simplify;
  rewrite ≐_com y x;
  // Goal: istrue (isLt (opp (x ≐ y))).
  rewrite Comp_isLt_opp (x ≐ y);
  // Goal: istrue (isGt (x ≐ y)).
  rewrite Hgt;
  refine ⊤ᵢ
end;

// ≤ multiplication monotonicity (on the right, for positive multiplier).
// a ≤ b ∧ 0 < c → a*c ≤ b*c.  Derived from mul_lt_mono_pos_l.
opaque symbol ≤_mul_pos_r (a b c : ℤ) :
  π (a ≤ b) → π (Z0 < c) → π (a * c ≤ b * c) ≔
begin
  assume a b c Hab Hposc Hgt;
  // Hgt : istrue (isGt ((a * c) ≐ (b * c))).
  have H1 : π (isGt ((a * c) ≐ (b * c)) = true) { refine istrue=true Hgt };
  have H2 : π (b * c < a * c) { refine isGt_true_implies_lt (a * c) (b * c) H1 };
  have H3 : π (b < a) { refine ∧ₑ₂ (mul_lt_mono_pos_l c Hposc b a) H2 };
  refine <_neg_≤ b a H3 Hab
end;

// ∀ p, 1 ≤ Zpos p.  All ℙ values are ≥ 1.
opaque symbol Z_one_le_Zpos (p : ℙ) : π (Zpos H ≤ Zpos p) ≔
begin
  induction
  { assume p1 IH Hgt; refine Hgt }
  { assume p1 IH Hgt; refine Hgt }
  { assume Hgt; refine Hgt }
end;

// Zpos p * M ≥ M  for M > 0.  Combine Z_one_le_Zpos with ≤_mul_pos_r.
opaque symbol Zpos_mul_ge_M (p : ℙ) (M : ℤ) :
  π (Z0 < M) → π (M ≤ Zpos p * M) ≔
begin
  assume p M HposM;
  have H1 : π (Zpos H ≤ Zpos p) { refine Z_one_le_Zpos p };
  have H2 : π (Zpos H * M ≤ Zpos p * M)
    { refine ≤_mul_pos_r (Zpos H) (Zpos p) M H1 HposM };
  // Goal: M ≤ Zpos p * M.  Rewrite M → 1 * M only on the LHS via ind_eq.
  refine ind_eq (eq_sym (Z_1_mul_l M)) (λ z, z ≤ Zpos p * M) H2
end;

// Zneg p * M ≤ —M  for M > 0.  Dual of Zpos_mul_ge_M via opp_le_mono.
opaque symbol Zneg_mul_le_neg_M (p : ℙ) (M : ℤ) :
  π (Z0 < M) → π (Zneg p * M ≤ — M) ≔
begin
  assume p M HposM;
  // Zneg p * M = —(Zpos p * M) (definitionally? let's verify).
  // Actually Zneg p * Zpos m = Zneg (mul p m), —(Zpos p * Zpos m) = —Zpos (mul p m) = Zneg (mul p m).
  // So Zneg p * M = —(Zpos p * M) when M = Zpos m.  By case on M.
  // From Zpos_mul_ge_M: M ≤ Zpos p * M, i.e., Zpos p * M ≥ M.
  // By opp_le_mono: —(Zpos p * M) ≤ —M.
  // Connect via neg_mul_l.
  have HposGe : π (Zpos p * M ≥ M)
    { refine ∧ₑ₂ (≤_≥ (Zpos p * M) M) (Zpos_mul_ge_M p M HposM) };
  have Hopp : π (— (Zpos p * M) ≤ — M)
    { refine ∧ₑ₁ (opp_le_mono (Zpos p * M) M) HposGe };
  // Goal: Zneg p * M ≤ — M.  Convert via eq_sym (neg_mul_l).
  refine ind_eq (eq_sym (neg_mul_l (Zpos p) M)) (λ z, z ≤ — M) Hopp
end;

// If 0 < M and -M < z*M < M, then z*M = 0.  Proof: case on z.
opaque symbol Z_mul_M_zero_when_bounded (z M : ℤ) :
  π (Z0 < M) → π (— M < z * M) → π (z * M < M) → π (z * M = Z0) ≔
begin
  induction
  // z = Z0
  { assume M HposM Hl Hu; refine Z0_*_l M }
  // z = Zpos p: z*M ≥ M, contradicts z*M < M.
  { assume p M HposM Hl Hu;
    refine ⊥ₑ (<_neg_≤ (Zpos p * M) M Hu (Zpos_mul_ge_M p M HposM)) }
  // z = Zneg p: z*M ≤ —M, contradicts —M < z*M.
  { assume p M HposM Hl Hu;
    refine ⊥ₑ (<_neg_≤ (— M) (Zneg p * M) Hl (Zneg_mul_le_neg_M p M HposM)) }
end;

// 0 ≤ b → —b ≤ Z0.  Via opp_le_mono.
opaque symbol Z_neg_le_zero (b : ℤ) : π (Z0 ≤ b) → π (— b ≤ Z0) ≔
begin
  assume b Hb;
  have Hge : π (b ≥ Z0) { refine ∧ₑ₂ (≤_≥ b Z0) Hb };
  refine ∧ₑ₁ (opp_le_mono b Z0) Hge
end;

// a < M ∧ 0 ≤ b → a + —b < M.  Bound for the upper part.
opaque symbol Z_diff_lt_M (a b M : ℤ) :
  π (a < M) → π (Z0 ≤ b) → π (a + — b < M) ≔
begin
  assume a b M Ha Hb;
  have Hnegb : π (— b ≤ Z0) { refine Z_neg_le_zero b Hb };
  have Hstep1 : π (a + — b < M + — b) { refine <_compat_add a M (— b) Ha };
  have Hstep2 : π (— b + M ≤ Z0 + M) { refine ≤_compat_add (— b) Z0 M Hnegb };
  // Reorder LHS of Hstep2: M + —b ≤ M.  (Z0 + M reduces to M.)
  have Hstep3 : π (M + — b ≤ M)
    { refine ind_eq (+_com M (— b)) (λ z, z ≤ M) Hstep2 };
  refine <_trans_1 (a + — b) (M + — b) M Hstep1 Hstep3
end;

// 0 ≤ a ∧ b < M → —M < a + —b.  Bound for the lower part.
opaque symbol Z_diff_gt_neg_M (a b M : ℤ) :
  π (Z0 ≤ a) → π (b < M) → π (— M < a + — b) ≔
begin
  assume a b M Ha Hb;
  // b < M ⇔ M > b ⇔ —M < —b (by opp_lt_mono).  Use <_> : x < y ⇔ y > x.
  have HMgtb : π (M > b) { refine ∧ₑ₁ (<_> b M) Hb };
  // By opp_lt_mono: M > b ⇔ —M < —b.
  have HnegMlt : π (— M < — b) { refine ∧ₑ₁ (opp_lt_mono M b) HMgtb };
  // Add a: —M + a < —b + a (by <_compat_add ... wait but a ≥ 0 is what we have).
  // Hmm we need —M < a + —b.  Chain: —M ≤ —M + a < a + —b.
  // —M ≤ —M + a: from 0 ≤ a, ≤_compat_add Z0 a (—M).
  have Hstep1 : π (Z0 + (— M) ≤ a + (— M))
    { refine ≤_compat_add Z0 a (— M) Ha };
  // Z0 + (—M) reduces to —M.  a + (—M) we want to flip to (—M) + a then ... hmm let me think.
  // Actually goal: —M ≤ a + (—M) is the result.
  // After "Z0 + —M reduces to —M": —M ≤ a + —M.  But we want to use this differently.
  // Hmm wait, let me reconsider.  We want — M < a + — b.
  // From HnegMlt: —M < —b. By <_compat_add (—M) (—b) a: —M + a < —b + a.
  // Rewriting: a + —M = —M + a (by +_com), and a + —b = —b + a (by +_com).
  // So we want: a + —M ≤ a + —M < a + —b.  Hmm not quite.
  have Hstep2 : π ((— M) + a < (— b) + a)
    { refine <_compat_add (— M) (— b) a HnegMlt };
  // Now want: — M < a + — b.
  // From Hstep2: —M + a < —b + a.  Use +_com on both sides.
  // First flip RHS: —b + a = a + —b.
  have Hstep3 : π ((— M) + a < a + — b)
    { refine ind_eq (+_com a (— b)) (λ z, (— M) + a < z) Hstep2 };
  // Need: — M ≤ — M + a.  From 0 ≤ a via ≤_compat_add.
  have Hstep4 : π ((— M) ≤ (— M) + a)
    { // 0 ≤ a → 0 + (—M) ≤ a + (—M) → —M ≤ a + (—M) → —M ≤ (—M) + a.
      have H : π (Z0 + (— M) ≤ a + (— M)) { refine ≤_compat_add Z0 a (— M) Ha };
      // Z0 + —M ≡ —M.  a + —M = —M + a by +_com.
      refine ind_eq (+_com (— M) a) (λ z, — M ≤ z) H };
  refine <_trans_2 (— M) ((— M) + a) (a + — b) Hstep4 Hstep3
end;

// Helper: cancellation of + on the right.  a + c = b + c → a = b.
opaque symbol +_cancel_r (a b c : ℤ) : π (a + c = b + c) → π (a = b) ≔
begin
  assume a b c Heq;
  // a = (a + c) - c by simpl_right.  Apply to both sides via ind_eq.
  // First derive (a + c) - c = (b + c) - c from Heq.
  have H1 : π ((a + c) - c = (b + c) - c)
    { refine feq (λ z, z - c) Heq };
  // Transform H1's LHS from (a + c) - c to a via simpl_right.
  have H2 : π (a = (b + c) - c)
    { refine ind_eq (eq_sym (simpl_right a c)) (λ z, z = (b + c) - c) H1 };
  // Transform H2's RHS from (b + c) - c to b.
  refine ind_eq (eq_sym (simpl_right b c)) (λ z, a = z) H2
end;

// q*M + r = q'*M + r' ⇒ (q - q')*M = r' - r.  Pure Z arithmetic.
// We work in the `+ —` form (definition of `-`) for syntactic rewriting.
opaque symbol mod_diff_eq (q q' M r r' : ℤ) :
  π (q * M + r = q' * M + r') → π ((q - q') * M = r' - r) ≔
begin
  assume q q' M r r' Heq;
  // Switch to + — form so rewrites match.
  change π ((q + — q') * M = r' + — r);
  // Apply +_cancel_r with c = q'*M + r.
  refine +_cancel_r ((q + — q') * M) (r' + — r) (q' * M + r) _;
  // Goal: (q + —q')*M + (q'*M + r) = (r' + —r) + (q'*M + r).
  // Distribute on LHS.
  rewrite Z_distr_+_r q (— q') M;
  rewrite left neg_mul_l q' M;
  // LHS now: (q*M + —(q'*M)) + (q'*M + r).
  // Re-associate and cancel —(q'*M) with q'*M.
  rewrite +_assoc (q * M) (— (q' * M)) (q' * M + r);
  rewrite left +_assoc (— (q' * M)) (q' * M) r;
  rewrite +_com (— (q' * M)) (q' * M);
  rewrite -_same (q' * M);
  // LHS now: q*M + (Z0 + r) which reduces to q*M + r.
  // RHS: (r' + —r) + (q'*M + r).  Re-associate and cancel —r with r.
  rewrite +_assoc r' (— r) (q' * M + r);
  rewrite left +_assoc (— r) (q' * M) r;
  rewrite +_com (— r) (q' * M);
  rewrite +_assoc (q' * M) (— r) r;
  rewrite +_com (— r) r;
  rewrite -_same r;
  // RHS now: r' + (q'*M + Z0).  Reduce the Z0s, then flip.
  simplify;
  rewrite +_com r' (q' * M);
  // Goal: q*M + r = q'*M + r'.  This is Heq.
  refine Heq
end;

// Euclidean equation: X = (X / M)*M + (X mod M),  for X ≥ 0, M > 0.
opaque symbol mod_eq (X M : ℤ) :
  π (Z0 ≤ X) → π (Z0 < M) → π (X = div X M * M + modulo X M) ≔
begin
  induction
  // X = Z0:  div Z0 _ = 0;  modulo Z0 _ = 0;  0 = 0 * M + 0 = 0.
  { assume M H0X HposM;
    rewrite mod_Z0 M;
    simplify;
    reflexivity }
  // X = Zpos p
  { assume p;
    induction
    { assume H0X Hbot; refine ⊥ₑ Hbot }
    { assume m H0X HposM;
      rewrite mod_Zpos_Zpos p m;
      rewrite div_Zpos_Zpos p m;
      refine ∧ₑ₁ (pos_div_eucl_correct p (Zpos m) HposM) }
    { assume m H0X Hbot; refine ⊥ₑ Hbot } }
  // X = Zneg p: ⊥
  { assume p M H0X HposM; refine ⊥ₑ (H0X ⊤ᵢ) }
end;

// Uniqueness of the Euclidean remainder for non-negative dividends.
//   X ≥ 0, M > 0, 0 ≤ r < M, X = q*M + r  ⇒  modulo X M = r.
opaque symbol mod_unique (X q r M : ℤ) :
  π (Z0 ≤ X) → π (Z0 < M) → π (Z0 ≤ r) → π (r < M) →
  π (X = q * M + r) → π (modulo X M = r) ≔
begin
  assume X q r M H0X HposM H0r HrM Heq;
  have HrM_nonneg : π (Z0 ≤ modulo X M) { refine mod_nonneg X M H0X HposM };
  have HrM_lt    : π (modulo X M < M)   { refine mod_lt X M H0X HposM };
  have Hmod      : π (X = div X M * M + modulo X M) { refine mod_eq X M H0X HposM };
  have Hcomb : π (q * M + r = div X M * M + modulo X M)
    { refine ind_eq (eq_sym Heq) (λ z, z = div X M * M + modulo X M) Hmod };
  // mod_diff_eq gives us the equation in `-` form;  use `refine` to coerce to `+ —` form
  // via the `≔` definition of `-`.  This is needed so subsequent ind_eq calls match.
  have HmulEq : π ((q - div X M) * M = modulo X M + — r)
    { refine mod_diff_eq q (div X M) M r (modulo X M) Hcomb };
  have Hupper : π (modulo X M + — r < M)
    { refine Z_diff_lt_M (modulo X M) r M HrM_lt H0r };
  have Hlower : π (— M < modulo X M + — r)
    { refine Z_diff_gt_neg_M (modulo X M) r M HrM_nonneg HrM };
  have HzMzero : π ((q - div X M) * M = Z0)
    { refine Z_mul_M_zero_when_bounded (q - div X M) M HposM
        (ind_eq HmulEq (λ z, — M < z) Hlower)
        (ind_eq HmulEq (λ z, z < M) Hupper) };
  have HmodMinusR : π (modulo X M + — r = Z0)
    { refine ind_eq (eq_sym HmulEq) (λ z, z = Z0) HzMzero };
  // cancel_sub takes `a - b = 0` i.e. `a + — b = 0` after - unfolding.
  refine cancel_sub (modulo X M) r HmodMinusR
end;

// ----------------------------------------------------------------------
// Helpers built on top of mod_unique for the bvand_arith proof.
// ----------------------------------------------------------------------

// val (of_succ_nat X) = X + 1  for X : ℕ.  Bridge to Pos's val/succ.
opaque symbol val_of_succ_nat (X : ℕ) : π (val (of_succ_nat X) = X +1) ≔
begin
  induction
  // X = _0:  val (of_succ_nat _0) = val H = 1 = _0 + 1.
  { reflexivity }
  // X = X' +1:  val (of_succ_nat (X' +1)) = val (succ (of_succ_nat X')) = val(of_succ_nat X')+1.
  { assume X' IH;
    simplify;
    rewrite valS (of_succ_nat X');
    rewrite IH;
    reflexivity }
end;

// to_nat ∘ to_int is identity on ℕ.
opaque symbol to_nat_to_int_id (X : ℕ) : π (to_nat (to_int X) = X) ≔
begin
  induction
  // X = _0
  { reflexivity }
  // X = X' +1:  to_int (X'+1) = Zpos (of_succ_nat X');
  // to_nat (Zpos (of_succ_nat X')) = val (of_succ_nat X') = X' + 1.
  { assume X' IH;
    simplify;
    refine val_of_succ_nat X' }
end;

// Modulo idempotent for in-range values:  0 ≤ X < M ⇒ modulo X M = X.
// Apply mod_unique with q = Z0:  X = 0 * M + X.
opaque symbol mod_idempotent (X M : ℤ) :
  π (Z0 ≤ X) → π (X < M) → π (modulo X M = X) ≔
begin
  assume X M H0X HxM;
  // Use mod_unique with q = Z0, r = X.  Need 0 < M from 0 ≤ X < M.
  refine mod_unique X Z0 X M H0X (<_trans_2 Z0 X M H0X HxM) H0X HxM _;
  // X = 0 * M + X
  rewrite Z0_*_l M; reflexivity
end;

// to_int X ≥ 0  for any X : ℕ.
opaque symbol to_int_nonneg (X : ℕ) : π (Z0 ≤ to_int X) ≔
begin
  induction
  { assume Hgt; refine Hgt }
  { assume X' IH Hgt; refine Hgt }
end;

// Helper: bbterm_acc (true ⸬ rest) 0 = pow2_nat (size rest) + bbterm_acc rest 0.
opaque symbol bbterm_acc_true_zero (rest : 𝕃 bool) :
  π (bbterm_acc (true ⸬ rest) 0 = pow2_nat (size rest) + bbterm_acc rest 0) ≔
begin
  assume rest;
  refine ind_eq (eq_sym (Z_1_mul_l (pow2_nat (size rest))))
    (λ z, bbterm_acc (true ⸬ rest) 0 = z + bbterm_acc rest 0)
    (bbterm_acc_shift rest (Zpos H))
end;

// bbterm_acc bits 0 ≥ 0.  By induction on bits, case-split on head bit.
opaque symbol bbterm_acc_nonneg (bits : 𝕃 bool) : π (Z0 ≤ bbterm_acc bits 0) ≔
begin
  induction
  { assume Hgt; refine Hgt }
  { assume b rest IH;
    refine ind_𝔹_eq (λ b', Z0 ≤ bbterm_acc (b' ⸬ rest) 0) b _ _
    { assume Hb;
      rewrite Hb;
      rewrite bbterm_acc_true_zero rest;
      refine ≤_compat_≤ (pow2_nat (size rest)) (bbterm_acc rest 0)
        (<_≤ Z0 (pow2_nat (size rest)) (pow2_nat_pos (size rest))) IH }
    { assume Hb;
      rewrite Hb;
      refine IH } }
end;

// Helper: bbterm_acc (false ⸬ rest) 0 = bbterm_acc rest 0.
opaque symbol bbterm_acc_false_zero (rest : 𝕃 bool) :
  π (bbterm_acc (false ⸬ rest) 0 = bbterm_acc rest 0) ≔
begin assume rest; reflexivity end;

// pow2_nat (size (b ⸬ rest)) = pow2_nat (size rest) + pow2_nat (size rest).
opaque symbol pow2_nat_size_cons (b : 𝔹) (rest : 𝕃 bool) :
  π (pow2_nat (size (b ⸬ rest)) = pow2_nat (size rest) + pow2_nat (size rest)) ≔
begin
  assume b rest;
  refine Z_2_mul_eq_b_plus_b (pow2_nat (size rest))
end;

// bbterm_acc bits 0 < pow2_nat (size bits).  By induction on bits.
opaque symbol bbterm_acc_lt_pow2 (bits : 𝕃 bool) :
  π (bbterm_acc bits 0 < pow2_nat (size bits)) ≔
begin
  induction
  { refine ⊤ᵢ }
  { assume b rest IH;
    refine ind_𝔹_eq (λ b', bbterm_acc (b' ⸬ rest) 0 < pow2_nat (size (b' ⸬ rest))) b _ _
    { assume Hb;
      rewrite Hb;
      rewrite bbterm_acc_true_zero rest;
      rewrite pow2_nat_size_cons true rest;
      // Goal: pow2_nat (size rest) + bbterm_acc rest 0 < pow2_nat (size rest) + pow2_nat (size rest).
      have H1 : π (bbterm_acc rest 0 + pow2_nat (size rest)
                 < pow2_nat (size rest) + pow2_nat (size rest))
        { refine <_compat_add (bbterm_acc rest 0) (pow2_nat (size rest))
                              (pow2_nat (size rest)) IH };
      refine ind_eq (+_com (pow2_nat (size rest)) (bbterm_acc rest 0))
        (λ z, z < pow2_nat (size rest) + pow2_nat (size rest)) H1 }
    { assume Hb;
      rewrite Hb;
      rewrite bbterm_acc_false_zero rest;
      rewrite pow2_nat_size_cons false rest;
      // Goal: bbterm_acc rest 0 < pow2_nat (size rest) + pow2_nat (size rest).
      // IH: bbterm_acc rest 0 < pow2_nat (size rest).
      // pow2_nat (size rest) ≤ pow2_nat (size rest) + pow2_nat (size rest) since pow2_nat ≥ 0.
      // By <_trans_1.
      refine <_trans_1 (bbterm_acc rest 0) (pow2_nat (size rest))
        (pow2_nat (size rest) + pow2_nat (size rest)) IH _;
      // Sub: pow2_nat ≤ pow2_nat + pow2_nat.
      // From pow2_nat ≥ 0, by ≤_compat_add: 0 + pow2_nat ≤ pow2_nat + pow2_nat.
      // 0 + pow2_nat = pow2_nat.
      refine ind_eq (+_com (pow2_nat (size rest)) (pow2_nat (size rest)))
        (λ z, pow2_nat (size rest) ≤ z) _;
      // Goal: pow2_nat (size rest) ≤ pow2_nat (size rest) + pow2_nat (size rest).
      // From <_compat_≤: 0 < pow2_nat → 0 ≤ pow2_nat → 0 < pow2_nat + pow2_nat.  Wrong shape.
      // Simpler: pow2_nat ≤ pow2_nat + pow2_nat from 0 ≤ pow2_nat and add it.
      // Hmm: refine ≤_compat_add  pow2_nat (size rest)  (pow2_nat (size rest) + pow2_nat (size rest))  ...
      // Try: a + 0 ≤ a + b when 0 ≤ b.  Use ≤_compat_add.
      // Actually p ≤ p + p iff 0 ≤ p which we have (pow2_nat_pos).
      // ≤_compat_add x y a : x ≤ y → x + a ≤ y + a.
      // With x = 0, y = pow2_nat, a = pow2_nat: 0 ≤ pow2_nat → 0 + pow2_nat ≤ pow2_nat + pow2_nat → pow2_nat ≤ pow2_nat + pow2_nat.
      refine ≤_compat_add Z0 (pow2_nat (size rest)) (pow2_nat (size rest))
        (<_≤ Z0 (pow2_nat (size rest)) (pow2_nat_pos (size rest))) } }
end;


// THE deep bridge between Nat-level testbit and Z-level modulo.
// For non-negative X and any k, the value `X mod 2^(k+1)` decomposes as
// (the k-th bit of X) * 2^k + (X mod 2^k).
//
// This is the standard "X mod 2^(k+1) = bit_k(X)·2^k + X mod 2^k" identity.
// A self-contained proof would require a Nat-Z bridge for
// `(Z div X (2^k)) mod 2 = testbit (to_nat X) k`, beyond the current
// arithmetic infrastructure.  Status is analogous to BV_elim — a known
// mathematical fact treated as primitive.
symbol mod_pow2_succ_decompose (X : ℤ) (k : ℕ) :
  π (Z0 ≤ X) →
  π (modulo X (2 ^ (to_int (k +1)))
     = (if (testbit (to_nat X) k) (2 ^ (to_int k)) Z0) + modulo X (2 ^ (to_int k)));

// (3) The arithmetic key lemma.
opaque symbol bvand_arith_eq_bits (n : τ nat) (vx vy : τ int) :
  π (modulo (to_int ((to_nat vx) && (to_nat vy))) (2 ^ (to_int n))
   = modulo (bbterm_acc (zip_with bb_and (bits_of_n n vx) (bits_of_n n vy)) 0)
            (2 ^ (to_int n))) ≔
begin
  induction
  { assume vx vy;
    change π (modulo (to_int ((to_nat vx) && (to_nat vy))) 1 = modulo 0 1);
    rewrite modulo_one (to_int ((to_nat vx) && (to_nat vy)));
    rewrite modulo_one 0;
    reflexivity }
  { assume k IH vx vy;
    have HposY : π (Z0 ≤ to_int ((to_nat vx) && (to_nat vy)))
      { refine to_int_nonneg ((to_nat vx) && (to_nat vy)) };
    rewrite mod_pow2_succ_decompose (to_int ((to_nat vx) && (to_nat vy))) k HposY;
    rewrite to_nat_to_int_id ((to_nat vx) && (to_nat vy));
    rewrite land_spec (to_nat vx) (to_nat vy) k;
    rewrite IH vx vy;
    have Hsize : π (size (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) = k)
      { refine size_zip_with_bb_and k vx vy };
    have Hbtm_nn : π (Z0 ≤ bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
      { refine bbterm_acc_nonneg _ };
    have Hbtm_lt : π (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0
                    < (2 ^ (to_int k)))
      { refine ind_eq (eq_sym (pow2_nat_eq k))
          (λ z, bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0 < z)
          (ind_eq Hsize
            (λ z, bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0 < pow2_nat z)
            (bbterm_acc_lt_pow2 (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)))) };
    rewrite mod_idempotent (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
      (2 ^ (to_int k)) Hbtm_nn Hbtm_lt;
    refine ind_𝔹_eq
      (λ bv, (if bv (2 ^ (to_int k)) Z0)
             + bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0
           = modulo (bbterm_acc (bv ⸬ zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
                    (2 ^ (to_int (k +1))))
      ((testbit (to_nat vx) k) and (testbit (to_nat vy) k))
      _ _
    { assume Htrue;
      rewrite Htrue;
      simplify;
      rewrite bbterm_acc_true_zero (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy));
      rewrite Hsize;
      rewrite pow2_nat_eq k;
      have H_sum_nn : π (Z0 ≤ (2 ^ (to_int k))
                          + bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
        { refine ≤_compat_≤ (2 ^ (to_int k))
            (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
            (ind_eq (pow2_nat_eq k) (λ z, Z0 ≤ z) (<_≤ Z0 (pow2_nat k) (pow2_nat_pos k)))
            Hbtm_nn };
      have H_sum_lt : π ((2 ^ (to_int k))
                          + bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0
                        < 2 ^ (to_int (k +1)))
        { rewrite pow2_succ k;
          refine ind_eq (Z_2_mul_eq_b_plus_b (2 ^ (to_int k)))
            (λ z, (2 ^ (to_int k))
                  + bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0 < z)
            _;
          refine ind_eq
            (+_com (2 ^ (to_int k))
                   (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0))
            (λ z, z < (2 ^ (to_int k)) + (2 ^ (to_int k)))
            (<_compat_add
              (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
              (2 ^ (to_int k)) (2 ^ (to_int k)) Hbtm_lt) };
      symmetry;
      refine mod_idempotent
        ((2 ^ (to_int k)) + bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
        (2 ^ (to_int (k +1))) H_sum_nn H_sum_lt }
    { assume Hfalse;
      rewrite Hfalse;
      simplify;
      rewrite bbterm_acc_false_zero (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy));
      have H_lt_succ : π (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0
                       < 2 ^ (to_int (k +1)))
        { refine <_trans_1
            (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
            (2 ^ (to_int k)) (2 ^ (to_int (k +1))) Hbtm_lt _;
          rewrite pow2_succ k;
          refine Zpos_mul_ge_M (O H) (2 ^ (to_int k))
            (ind_eq (pow2_nat_eq k) (λ z, Z0 < z) (pow2_nat_pos k)) };
      symmetry;
      refine mod_idempotent
        (bbterm_acc (zip_with bb_and (bits_of_n k vx) (bits_of_n k vy)) 0)
        (2 ^ (to_int (k +1))) Hbtm_nn H_lt_succ } }
end;

// (3) bitblast_and itself.  Structural proof on top of the two pieces
// above: case-split x and y to MVBV n vx, MVBV n vy via BV_elim, then
// the ρ/χ-rules normalise both sides to `MVBV n (modulo _ (2 ^ to_int
// n))`, and the residual equation on the inner ℤs is exactly the
// arithmetic lemma — conclude by `feq (MVBV n)`.
opaque symbol bitblast_and [n : τ nat] (x y : BV n) :
  π (bvand x y = bbT n (zip_with bb_and (bits_of x) (bits_of y))) ≔
begin
  assume n x y;
  refine BV_elim (λ z, bvand z y = bbT n (zip_with bb_and (bits_of z) (bits_of y))) _ x;
  assume vx;
  refine BV_elim
    (λ z, bvand (MVBV n vx) z = bbT n (zip_with bb_and (bits_of (MVBV n vx)) (bits_of z))) _ y;
  assume vy;
  refine feq (MVBV n) (bvand_arith_eq_bits n vx vy)
end;

// Rule 108: bitblast_or — TODO: real proof (currently admitted).
opaque symbol bitblast_or [n : τ nat] (x y : BV n) :
  π (bvor x y = bbT n (zip_with bb_or (bits_of x) (bits_of y))) ≔
begin admit end;

// Rule 109: bitblast_xor — TODO: real proof (currently admitted).
opaque symbol bitblast_xor [n : τ nat] (x y : BV n) :
  π (bvxor x y = bbT n (zip_with bb_xor (bits_of x) (bits_of y))) ≔
begin admit end;

// Rule 110: bitblast_xnor — pointwise iff = ¬(a xor b).
opaque symbol bitblast_xnor [n : τ nat] (x y : BV n) :
  π (bvxnor x y = bbT n (zip_with bb_iff (bits_of x) (bits_of y))) ≔
begin admit end;

// Rule 101: bitblast_eq — TODO: real proof (currently admitted).
opaque symbol bitblast_eq [n : τ nat] (x y : BV n) :
  π (bveq x y = all bb_id (zip_with bb_iff (bits_of x) (bits_of y))) ≔
begin admit end;

// Rule 99: bitblast_concat — concatenation = list append in MSB-first form.
opaque symbol bitblast_concat [n m : τ nat] (x : BV n) (y : BV m) :
  π (bvconcat x y = bbT (Stdlib.Nat.+ n m) (bits_of x ++ bits_of y)) ≔
begin admit end;

// Rule 98: bitblast_extract — drop the i MSB-side bits of x, then take j−i+1.
opaque symbol bitblast_extract (j i : τ nat) [n : τ nat] (x : BV n) :
  π (bvextract j i x = bbT (extract_width j i) (take (extract_width j i) (drop i (bits_of x)))) ≔
begin admit end;

// ----------------------------------------------------------------------
// Sanity checks at width 4 (values mod 16)
// ----------------------------------------------------------------------

compute bvadd  (mkbv (to_nat 4)  7) (mkbv (to_nat 4)  5);  //  7 +  5         = 12
compute bvadd  (mkbv (to_nat 4)  7) (mkbv (to_nat 4) 15);  // 22 mod 16       =  6
compute bvneg  (mkbv (to_nat 4)  3);                       // −3 mod 16       = 13
compute bvnot  (mkbv (to_nat 4)  3);                       // 15 − 3          = 12
compute bvmul  (mkbv (to_nat 4)  3) (mkbv (to_nat 4)  7);  // 21 mod 16       =  5
compute bvand  (mkbv (to_nat 4) 12) (mkbv (to_nat 4) 10);  // 1100 & 1010     =  8
compute bvor   (mkbv (to_nat 4) 12) (mkbv (to_nat 4) 10);  // 1100 | 1010     = 14
compute bvshl  (mkbv (to_nat 4)  3) (mkbv (to_nat 4)  2);  //  3 <<  2        = 12
compute bvshl  (mkbv (to_nat 4)  3) (mkbv (to_nat 4)  3);  // 24 mod 16       =  8
compute bvlshr (mkbv (to_nat 4) 12) (mkbv (to_nat 4)  2);  // 12 >>  2        =  3
compute bvudiv (mkbv (to_nat 4) 12) (mkbv (to_nat 4)  3);  // 12 /  3         =  4
compute bvudiv (mkbv (to_nat 4) 12) (mkbv (to_nat 4)  0);  // SMT-LIB: all-1s = 15
compute bvurem (mkbv (to_nat 4) 12) (mkbv (to_nat 4)  5);  // 12 mod 5        =  2
compute bvurem (mkbv (to_nat 4) 12) (mkbv (to_nat 4)  0);  // SMT-LIB: x      = 12



